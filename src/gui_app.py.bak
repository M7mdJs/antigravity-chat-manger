    # â”€â”€ Universal Smooth Mousewheel Scrolling â”€â”€

    def _bind_smooth_scrolling(self):
        def is_inside(child, parent):
            curr = child
            while curr is not None:
                if curr == parent or curr == getattr(parent, "_parent_canvas", None) or curr == getattr(parent, "_parent_frame", None):
                    return True
                curr = getattr(curr, "master", None)
            return False

        def on_global_mousewheel(event):
            try:
                w = self.winfo_containing(event.x_root, event.y_root)
            except Exception:
                w = None

            if not w:
                return "break"

            delta = int(-1 * (event.delta / 120))
            if delta == 0:
                delta = -1 if event.delta > 0 else 1

            # Sidebar
            if is_inside(w, self.sidebar_frame) or is_inside(w, self.conv_scroll):
                canvas = getattr(self.conv_scroll, "_parent_canvas", None)
                if canvas and canvas.winfo_exists():
                    canvas.yview_scroll(delta, "units")
                return "break"

            # Main Chat Area
            if is_inside(w, self.main_frame) or is_inside(w, self.content_scroll):
                canvas = getattr(self.content_scroll, "_parent_canvas", None)
                if canvas and canvas.winfo_exists():
                    canvas.yview_scroll(delta, "units")
                    self._schedule_scroll_check()
                return "break"

            return "break"

        self._content_wheel_fn = on_global_mousewheel

        self.bind_all("<MouseWheel>", on_global_mousewheel, add="+")
        self.bind_class("Text", "<MouseWheel>", on_global_mousewheel)

        def on_content_canvas_scrolled(first, last):
            sb = getattr(self.content_scroll, "_scrollbar", None)
            if sb and sb.winfo_exists():
                sb.set(float(first), float(last))
            if float(last) > 0.80:
                self._schedule_scroll_check()

        canvas = getattr(self.content_scroll, "_parent_canvas", None)
        if canvas:
            canvas.configure(yscrollcommand=on_content_canvas_scrolled)

    def _schedule_scroll_check(self):
        if self._scroll_timer:
            self.after_cancel(self._scroll_timer)
        self._scroll_timer = self.after(50, self._check_auto_load_more)

    def _check_auto_load_more(self):
        if self._is_loading_chunk:
            return
        if self.rendered_count >= len(self.active_messages):
            return
        if self.current_tab != "Chat View":
            return

        canvas = getattr(self.content_scroll, "_parent_canvas", None)
        if not canvas or not canvas.winfo_exists():
            return

        try:
            _, y2 = canvas.yview()
            if y2 > 0.78:
                self._render_next_chat_chunk()
        except Exception:
            pass

    # â”€â”€ Data Loading & Merging â”€â”€

    def _refresh_all(self):
        self.status_lbl.configure(text="Checking LanguageServer...", text_color=self.theme["text_muted"])
        threading.Thread(target=self._async_load_data, daemon=True).start()

    def _async_load_data(self):
        connected = self.client.refresh_connection()
        ep = self.client.endpoint

        disk_map = scan_disk_conversations()
        api_items = self.client.get_all_trajectories() if connected else {}

        merged = dict(disk_map)
        for cid, api_info in api_items.items():
            if cid in merged:
                merged[cid].source = "api"
                if api_info.get("summary"):
                    merged[cid].title = api_info["summary"]
                if api_info.get("stepCount"):
                    merged[cid].step_count = api_info["stepCount"]
                if api_info.get("lastModifiedTime"):
                    merged[cid].last_modified_time = api_info["lastModifiedTime"]
            else:
                merged[cid] = ConversationSummary(
                    id=cid,
                    title=api_info.get("summary") or f"Session {cid[:8]}",
                    preview=api_info.get("summary") or "",
                    step_count=api_info.get("stepCount", 0),
                    last_modified_time=api_info.get("lastModifiedTime"),
                    source="api",
                )

        items = list(merged.values())
        items.sort(key=lambda x: x.last_modified_time or "", reverse=True)

        self.after(0, lambda: self._on_data_loaded(items, connected, ep))

    def _on_data_loaded(self, items: list[ConversationSummary], connected: bool, ep: Any):
        self.conversations = items
        self._restore_status_label()
        self._render_conversation_list()

        if self.conversations:
            target = next((c for c in self.conversations if c.id == self.active_id), self.conversations[0])
            if target.id != self.active_id:
                self._select_conversation(target)

    # â”€â”€ Sidebar Conversation List â”€â”€

    def _on_search_changed(self, event=None):
        self.search_query = self.search_entry.get().strip().lower()
        self._render_conversation_list()

    def _on_filter_changed(self, choice: str):
        self.current_filter = choice
        self._render_conversation_list()

    def _render_conversation_list(self):
        t = self.theme
        for widget in self.conv_scroll.winfo_children():
            widget.destroy()

        filtered = []
        for c in self.conversations:
            if self.current_filter == "Live API" and c.source != "api":
                continue
            if self.current_filter == "On Disk" and c.source != "disk":
                continue
            if self.search_query:
                in_title = self.search_query in c.title.lower()
                in_ws = c.workspace and self.search_query in c.workspace.lower()
                in_preview = c.preview and self.search_query in c.preview.lower()
                if not (in_title or in_ws or in_preview):
                    continue
            filtered.append(c)

        if not filtered:
            lbl = ctk.CTkLabel(
                self.conv_scroll,
                text="No conversations found.",
                font=ctk.CTkFont(size=12),
                text_color=t["text_muted"],
            )
            lbl.pack(pady=24)
            return

        for c in filtered:
            is_active = (c.id == self.active_id)
            card_bg = t["bg_card_active"] if is_active else t["bg_card"]
            border_color = t["border_card_active"] if is_active else t["border_card"]
            border_width = 1.5 if is_active else 1

            card = ctk.CTkFrame(
                self.conv_scroll,
                fg_color=card_bg,
                border_color=border_color,
                border_width=border_width,
                corner_radius=8,
                cursor="hand2",
            )
            card.pack(fill="x", pady=2, padx=4)
            card.bind("<Button-1>", lambda e, item=c: self._select_conversation(item))

            # Reshaped Arabic Title
            clean_title = fix_arabic(c.title[:48])
            t_lbl = ctk.CTkLabel(
                card,
                text=clean_title,
                font=ctk.CTkFont(size=12, weight="bold"),
                text_color=t["accent_blue"] if is_active else t["text_primary"],
                anchor="w",
            )
            t_lbl.pack(fill="x", padx=10, pady=(8, 1))
            t_lbl.bind("<Button-1>", lambda e, item=c: self._select_conversation(item))

            # Subtitle (Workspace / preview)
            sub_text = ""
            if c.workspace:
                ws_name = c.workspace.replace("\\", "/").split("/")[-1]
                sub_text = ws_name
            elif c.preview and not c.preview.startswith("file:"):
                sub_text = c.preview[:48]
            else:
                sub_text = c.id[:12]

            p_lbl = ctk.CTkLabel(
                card,
                text=fix_arabic(sub_text),
                font=ctk.CTkFont(size=10),
                text_color=t["text_muted"],
                anchor="w",
            )
            p_lbl.pack(fill="x", padx=10, pady=(0, 4))
            p_lbl.bind("<Button-1>", lambda e, item=c: self._select_conversation(item))

            # Footer Metadata
            footer = ctk.CTkFrame(card, fg_color="transparent")
            footer.pack(fill="x", padx=10, pady=(0, 7))
            footer.bind("<Button-1>", lambda e, item=c: self._select_conversation(item))

            src_color = t["status_green"] if c.source == "api" else t["text_muted"]
            src_lbl = ctk.CTkLabel(
                footer,
                text=c.source.upper(),
                font=ctk.CTkFont(size=9, weight="bold"),
                text_color=src_color,
            )
            src_lbl.pack(side="left")
            src_lbl.bind("<Button-1>", lambda e, item=c: self._select_conversation(item))

            bullet = ctk.CTkLabel(footer, text="  Â·  ", font=ctk.CTkFont(size=9), text_color=t["text_muted"])
            bullet.pack(side="left")

            steps_lbl = ctk.CTkLabel(
                footer,
                text=f"{c.step_count} steps",
                font=ctk.CTkFont(size=9),
                text_color=t["text_muted"],
            )
            steps_lbl.pack(side="left")
            steps_lbl.bind("<Button-1>", lambda e, item=c: self._select_conversation(item))

            date_str = (c.last_modified_time or "")[:10]
            date_lbl = ctk.CTkLabel(
                footer,
                text=date_str,
                font=ctk.CTkFont(size=9),
                text_color=t["text_muted"],
            )
            date_lbl.pack(side="right")
            date_lbl.bind("<Button-1>", lambda e, item=c: self._select_conversation(item))

            if not is_active:
                def _make_hover(target_card):
                    def _enter(e):
                        if target_card.winfo_exists():
                            target_card.configure(fg_color=t["bg_card_hover"])
                    def _leave(e):
                        if target_card.winfo_exists():
                            target_card.configure(fg_color=t["bg_card"])
                    return _enter, _leave

                _ent, _lev = _make_hover(card)
                for w in (card, t_lbl, p_lbl, footer, src_lbl, bullet, steps_lbl, date_lbl):
                    w.bind("<Enter>", _ent, add="+")
                    w.bind("<Leave>", _lev, add="+")

    # â”€â”€ Selecting and Loading Conversation â”€â”€

    def _select_conversation(self, summary: ConversationSummary):
        self.active_id = summary.id
        self.active_summary = summary

        # Header values
        self.title_label.configure(text=fix_arabic(summary.title))
        self.id_lbl.configure(text=f"ID: {summary.id[:8]}...")
        self.steps_lbl.configure(text=f"{summary.step_count} steps")
        self.source_lbl.configure(text=f"Source: {summary.source}")
        ws_name = summary.workspace.replace("\\", "/").split("/")[-1] if summary.workspace else "Default"
        self.ws_lbl.configure(text=f"Workspace: {fix_arabic(ws_name)}")

        self._render_conversation_list()
        self._show_loading()

        threading.Thread(target=self._async_load_conversation, args=(summary.id,), daemon=True).start()

    def _show_loading(self):
        for widget in self.content_scroll.winfo_children():
            widget.destroy()
        lbl = ctk.CTkLabel(
            self.content_scroll,
            text="Loading conversation...",
            font=ctk.CTkFont(size=13),
            text_color=self.theme["text_muted"],
        )
        lbl.pack(pady=40)

    def _async_load_conversation(self, cascade_id: str):
        messages = []

        if self.client.is_connected() or self.client.refresh_connection():
            traj = self.client.get_trajectory(cascade_id)
            if traj:
                messages = parse_api_trajectory(traj)

        if not messages:
            records = read_transcript_lines(cascade_id)
            if records:
                messages = parse_transcript_records(records)

        self.after(0, lambda: self._on_conversation_loaded(messages))

    def _on_conversation_loaded(self, messages: list[ConversationMessage]):
        self.active_messages = messages
        self._reset_and_render_tab()

    def _on_tab_changed(self, choice: str):
        self.current_tab = choice
        self._reset_and_render_tab()

    def _toggle_md_view(self):
        self.md_view_enabled = not self.md_view_enabled
        self.md_toggle_btn.configure(
            text=f"MD View: {'ON' if self.md_view_enabled else 'OFF'}",
            fg_color=self.theme["accent_blue"] if self.md_view_enabled else self.theme["btn_secondary"],
            text_color="#FFFFFF" if self.md_view_enabled else self.theme["btn_secondary_text"],
            border_width=0 if self.md_view_enabled else 1,
        )
        self._reset_and_render_tab()

    def _reset_and_render_tab(self):
        for widget in self.content_scroll.winfo_children():
            widget.destroy()

        if not self.active_messages:
            empty_lbl = ctk.CTkLabel(
                self.content_scroll,
                text="No messages recorded in this trajectory.",
                font=ctk.CTkFont(size=13),
                text_color=self.theme["text_muted"],
            )
            empty_lbl.pack(pady=30)
            return

        if self.current_tab == "Chat View":
            self.rendered_count = 0
            self.load_more_frame = None
            self._render_next_chat_chunk()
        elif self.current_tab == "AI Reasoning":
            self._render_reasoning_view()
        elif self.current_tab == "Tool Logs & Diffs":
            self._render_tools_view()
        elif self.current_tab == "Raw JSON":
            self._render_raw_view()

    # â”€â”€ Chunked / Virtualized Progressive Rendering â”€â”€

    def _render_next_chat_chunk(self):
        if self._is_loading_chunk:
            return
        self._is_loading_chunk = True

        if self.load_more_frame and self.load_more_frame.winfo_exists():
            self.load_more_frame.destroy()
            self.load_more_frame = None

        total = len(self.active_messages)
        start = self.rendered_count
        end = min(start + self.CHUNK_SIZE, total)
        chunk = self.active_messages[start:end]

        for msg in chunk:
            self._render_single_message(msg)

        self.rendered_count = end

        # Bottom progressive controls or end marker
        t = self.theme
        if self.rendered_count < total:
            remaining = total - self.rendered_count
            pct = int((self.rendered_count / total) * 100)

            footer_frame = ctk.CTkFrame(self.content_scroll, fg_color="transparent")
            footer_frame.pack(fill="x", padx=16, pady=14)
            self.load_more_frame = footer_frame

            info_lbl = ctk.CTkLabel(
                footer_frame,
                text=f"Showing {self.rendered_count} of {total} messages ({pct}%) â€¢ Scroll down to auto-load",
                font=ctk.CTkFont(size=11),
                text_color=t["text_muted"],
            )
            info_lbl.pack(side="left")

            btn_box = ctk.CTkFrame(footer_frame, fg_color="transparent")
            btn_box.pack(side="right")

            more_btn = ctk.CTkButton(
                btn_box,
                text=f"Load Next {min(self.CHUNK_SIZE, remaining)}",
                fg_color=t["btn_secondary"],
                hover_color=t["btn_secondary_hover"],
                text_color=t["btn_secondary_text"],
                border_color=t["btn_secondary_border"],
                border_width=1,
                font=ctk.CTkFont(size=11),
                height=28,
                corner_radius=6,
                command=self._render_next_chat_chunk,
            )
            more_btn.pack(side="left", padx=4)

            all_btn = ctk.CTkButton(
                btn_box,
                text=f"Load All ({remaining})",
                fg_color=t["accent_blue"],
                hover_color=t["accent_blue_hover"],
                text_color="#FFFFFF",
                font=ctk.CTkFont(size=11, weight="bold"),
                height=28,
                corner_radius=6,
                command=self._load_all_remaining_messages,
            )
            all_btn.pack(side="left", padx=4)
        else:
            end_frame = ctk.CTkFrame(self.content_scroll, fg_color="transparent")
            end_frame.pack(fill="x", padx=16, pady=16)
            self.load_more_frame = end_frame

            end_lbl = ctk.CTkLabel(
                end_frame,
                text=f"âœ“ All {total} messages loaded",
                font=ctk.CTkFont(size=11),
                text_color=t["text_muted"],
            )
            end_lbl.pack(anchor="center")

        self._is_loading_chunk = False

    def _load_all_remaining_messages(self):
        if self.rendered_count < len(self.active_messages):
            self._render_next_chat_chunk()
            if self.rendered_count < len(self.active_messages):
                self.after(20, self._load_all_remaining_messages)

    def _render_single_message(self, msg: ConversationMessage):
        t = self.theme
        is_user = (msg.role == "user")
        card_bg = t["user_bubble"] if is_user else t["assistant_bubble"]
        border_clr = t["user_border"] if is_user else t["assistant_border"]

        msg_card = ctk.CTkFrame(
            self.content_scroll,
            fg_color=card_bg,
            border_color=border_clr,
            border_width=1,
            corner_radius=10,
        )
        msg_card.pack(fill="x", padx=4, pady=6)

        # Header Row
        hdr = ctk.CTkFrame(msg_card, fg_color="transparent")
        hdr.pack(fill="x", padx=14, pady=(10, 4))

        role_label = "ðŸ‘¤ You" if is_user else "ðŸ¤– Assistant"
        role_color = t["user_text_header"] if is_user else t["assistant_text_header"]
        role_lbl = ctk.CTkLabel(
            hdr,
            text=role_label,
            font=ctk.CTkFont(size=13, weight="bold"),
            text_color=role_color,
        )
        role_lbl.pack(side="left")

        if msg.model:
            m_tag = ctk.CTkLabel(
                hdr,
                text=f"[{msg.model}]",
                font=ctk.CTkFont(family="Consolas", size=10),
                text_color=t["text_muted"],
                fg_color=t["thinking_bg"],
                corner_radius=4,
                padx=6,
                pady=1,
            )
            m_tag.pack(side="left", padx=8)

        # Copy single message button
        copy_msg_btn = ctk.CTkButton(
            hdr,
            text="Copy",
            width=50,
            height=22,
            corner_radius=4,
            fg_color=t["btn_secondary"],
            hover_color=t["btn_secondary_hover"],
            text_color=t["btn_secondary_text"],
            border_color=t["btn_secondary_border"],
            border_width=1,
            font=ctk.CTkFont(size=10),
            command=lambda content=msg.content: self._copy_single_message(content),
        )
        copy_msg_btn.pack(side="right", padx=(8, 0))

        if msg.timestamp:
            ts_lbl = ctk.CTkLabel(
                hdr,
                text=msg.timestamp[:19],
                font=ctk.CTkFont(size=10),
                text_color=t["text_muted"],
            )
            ts_lbl.pack(side="right")

        # Collapsible Reasoning Process (Thinking Box)
        if msg.thinking:
            dur = f" ({msg.thinking_duration})" if msg.thinking_duration else ""
            t_frame = ctk.CTkFrame(
                msg_card,
                fg_color=t["thinking_bg"],
                border_color=t["thinking_border"],
                border_width=1,
                corner_radius=6,
            )
            t_frame.pack(fill="x", padx=14, pady=(4, 8))

            is_expanded = [False]

            t_toggle_btn = ctk.CTkButton(
                t_frame,
                text=f"â–¶ Reasoning Process{dur}  â€” click to expand",
                font=ctk.CTkFont(size=11, weight="bold"),
                text_color=t["text_secondary"],
                fg_color="transparent",
                hover_color=t["bg_card_hover"],
                anchor="w",
                height=28,
                corner_radius=4,
            )
            t_toggle_btn.pack(fill="x", padx=6, pady=2)

            t_box = ctk.CTkTextbox(
                t_frame,
                fg_color=t["bg_card"],
                text_color=t["text_secondary"],
                font=ctk.CTkFont(family="Consolas", size=11),
                height=120,
                corner_radius=4,
            )
            t_box.insert("1.0", fix_arabic(msg.thinking))
            t_box.configure(state="disabled")

            def toggle_thinking(btn=t_toggle_btn, box=t_box, state=is_expanded, d=dur):
                if state[0]:
                    box.pack_forget()
                    btn.configure(text=f"â–¶ Reasoning Process{d}  â€” click to expand")
                    state[0] = False
                else:
                    box.pack(fill="x", padx=8, pady=(0, 8))
                    btn.configure(text=f"â–¼ Reasoning Process{d}  â€” click to collapse")
                    state[0] = True

            t_toggle_btn.configure(command=toggle_thinking)

        # Main Message Text
        if msg.content:
            if self.md_view_enabled:
                md_viewer = MarkdownViewer(
                    msg_card,
                    scroll_callback=self._content_wheel_fn,
                    is_dark=(self.current_theme_name == "dark"),
                    bg=card_bg,
                )
                md_viewer.pack(fill="x", padx=10, pady=(2, 8))
                md_viewer.set_markdown(msg.content)
            else:
                clean_content = fix_arabic(msg.content)
                txt_box = ctk.CTkTextbox(
                    msg_card,
                    fg_color="transparent",
                    text_color=t["text_primary"],
                    font=ctk.CTkFont(size=12),
                    wrap="word",
                    height=max(45, min(320, len(clean_content.splitlines()) * 19)),
                )
                txt_box.pack(fill="x", padx=14, pady=(2, 10))
                txt_box.insert("1.0", clean_content)
                txt_box.configure(state="disabled")

        # Tool Actions
        if msg.tools:
            tools_box = ctk.CTkFrame(msg_card, fg_color=t["tool_bg"], border_color=t["tool_border"], border_width=1, corner_radius=6)
            tools_box.pack(fill="x", padx=14, pady=(0, 10))

            for tool_item in msg.tools:
                if tool_item.name == "run_command":
                    cmd_line = tool_item.input_data.get("command", "")
                    c_lbl = ctk.CTkLabel(
                        tools_box,
                        text=f"$ {cmd_line}",
                        font=ctk.CTkFont(family="Consolas", size=11),
                        text_color=t["status_amber"],
                        anchor="w",
                    )
                    c_lbl.pack(fill="x", padx=10, pady=3)
                elif tool_item.diff:
                    d_lbl = ctk.CTkLabel(
                        tools_box,
                        text=f"Edit: {tool_item.input_data.get('file', 'file')}",
                        font=ctk.CTkFont(family="Consolas", size=11),
                        text_color=t["status_green"],
                        anchor="w",
                    )
                    d_lbl.pack(fill="x", padx=10, pady=3)
                elif tool_item.summary:
                    s_lbl = ctk.CTkLabel(
                        tools_box,
                        text=f"{tool_item.name}: {tool_item.summary}",
                        font=ctk.CTkFont(size=11),
                        text_color=t["text_muted"],
                        anchor="w",
                    )
                    s_lbl.pack(fill="x", padx=10, pady=3)

    def _copy_single_message(self, text: str):
        if not text:
            return
        self.clipboard_clear()
        self.clipboard_append(text)
        self.status_lbl.configure(text="Message copied to clipboard!", text_color=self.theme["status_green"])
        self.after(2000, self._restore_status_label)

    def _restore_status_label(self):
        connected = self.client.is_connected()
        ep = self.client.endpoint
        if connected and ep:
            self.status_lbl.configure(
                text=f"â— LanguageServer: Port {ep.port} (PID {ep.pid})",
                text_color=self.theme["status_green"],
            )
        else:
            self.status_lbl.configure(
                text="â—‹ LanguageServer: Offline (Using disk archive)",
                text_color=self.theme["status_amber"],
            )

    def _render_reasoning_view(self):
        t = self.theme
        thinkings = [m for m in self.active_messages if m.thinking]
        if not thinkings:
            lbl = ctk.CTkLabel(
                self.content_scroll,
                text="No reasoning steps recorded in this session.",
                font=ctk.CTkFont(size=12),
                text_color=t["text_muted"],
            )
            lbl.pack(pady=30)
            return

        for i, m in enumerate(thinkings):
            card = ctk.CTkFrame(
                self.content_scroll,
                fg_color=t["bg_card"],
                border_color=t["border_card"],
                border_width=1,
                corner_radius=8,
            )
            card.pack(fill="x", padx=6, pady=6)

            hdr = ctk.CTkLabel(
                card,
                text=f"Step #{i+1} Thought Process ({m.thinking_duration or 'instant'})",
                font=ctk.CTkFont(size=12, weight="bold"),
                text_color=t["text_secondary"],
                anchor="w",
            )
            hdr.pack(fill="x", padx=12, pady=(10, 4))

            box = ctk.CTkTextbox(
                card,
                fg_color=t["thinking_bg"],
                text_color=t["text_primary"],
                font=ctk.CTkFont(family="Consolas", size=11),
                height=160,
                corner_radius=6,
            )
            box.pack(fill="x", padx=12, pady=(0, 12))
            box.insert("1.0", fix_arabic(m.thinking))
            box.configure(state="disabled")

    def _render_tools_view(self):
        t = self.theme
        all_tools = []
        for m in self.active_messages:
            all_tools.extend(m.tools)

        if not all_tools:
            lbl = ctk.CTkLabel(
                self.content_scroll,
                text="No commands or code edits in this session.",
                font=ctk.CTkFont(size=12),
                text_color=t["text_muted"],
            )
            lbl.pack(pady=30)
            return

        for tool_item in all_tools:
            card = ctk.CTkFrame(
                self.content_scroll,
                fg_color=t["bg_card"],
                border_color=t["border_card"],
                border_width=1,
                corner_radius=8,
            )
            card.pack(fill="x", padx=6, pady=5)

            title_txt = f"{tool_item.name}"
            if tool_item.action_type == "command":
                title_txt = f"Terminal Command (Exit: {tool_item.exit_code if tool_item.exit_code is not None else 0})"
            elif tool_item.diff:
                title_txt = f"Code Edit: {tool_item.input_data.get('file', '')}"

            lbl = ctk.CTkLabel(
                card,
                text=title_txt,
                font=ctk.CTkFont(size=12, weight="bold"),
                text_color=t["status_amber"] if "Terminal" in title_txt else t["status_green"],
                anchor="w",
            )
            lbl.pack(fill="x", padx=12, pady=(8, 2))

            body_txt = tool_item.diff or tool_item.output_data or json.dumps(tool_item.input_data, indent=2)
            box = ctk.CTkTextbox(
                card,
                fg_color=t["tool_bg"],
                text_color=t["text_primary"],
                font=ctk.CTkFont(family="Consolas", size=11),
                height=120,
                corner_radius=6,
            )
            box.pack(fill="x", padx=12, pady=(0, 10))
            box.insert("1.0", body_txt)
            box.configure(state="disabled")

    def _render_raw_view(self):
        if not self.active_summary:
            return
        t = self.theme
        raw_json_str = export_json(self.active_summary, self.active_messages)

        box = ctk.CTkTextbox(
            self.content_scroll,
            fg_color=t["bg_card"],
            text_color=t["accent_blue"],
            font=ctk.CTkFont(family="Consolas", size=11),
            height=600,
            corner_radius=8,
            border_color=t["border_card"],
            border_width=1,
        )
        box.pack(fill="both", expand=True, padx=6, pady=6)
        box.insert("1.0", raw_json_str)
        box.configure(state="disabled")

    # â”€â”€ Actions: Copy, Export, Import, Recover â”€â”€

    def _copy_as_markdown(self):
        if not self.active_summary:
            return
        md = export_markdown(self.active_summary, self.active_messages)
        self.clipboard_clear()
        self.clipboard_append(md)
        messagebox.showinfo("Copied", "Conversation copied to clipboard as Markdown.")

    def _export_active(self, fmt: str):
        if not self.active_summary:
            messagebox.showwarning("Warning", "Please select a conversation first.")
            return

        clean_title = "".join(c for c in self.active_summary.title if c.isalnum() or c in (" ", "-", "_"))[:30].strip()
        default_name = f"{clean_title}_{self.active_summary.id[:8]}.{fmt}"

        file_types = {
            "md": [("Markdown File", "*.md")],
            "json": [("JSON File", "*.json")],
            "html": [("HTML Document", "*.html")],
            "db": [("SQLite Database", "*.db")],
            "pb": [("Protobuf File", "*.pb")],
        }

        save_path = filedialog.asksaveasfilename(
            defaultextension=f".{fmt}",
            filetypes=file_types.get(fmt, [("All Files", "*.*")]),
            initialfile=default_name,
            title=f"Export as {fmt.upper()}",
        )
        if not save_path:
            return

        try:
            if fmt in ("db", "pb"):
                res = export_database_file(self.active_summary, Path(save_path), fmt=fmt)
                if res.get("success"):
                    messagebox.showinfo("Export Successful", f"Session database saved:\n{save_path}")
                else:
                    messagebox.showerror("Export Failed", res.get("error", "Failed exporting database."))
                return

            if fmt == "json":
                content = export_json(self.active_summary, self.active_messages)
            elif fmt == "html":
                content = export_html(self.active_summary, self.active_messages)
            else:
                content = export_markdown(self.active_summary, self.active_messages)

            Path(save_path).write_text(content, encoding="utf-8")
            messagebox.showinfo("Export Successful", f"File saved:\n{save_path}")
        except Exception as e:
            messagebox.showerror("Export Failed", str(e))

    def _open_recovery_dialog(self):
        RecoveryDialog(self)

    def _open_import_dialog(self):
        file_path = filedialog.askopenfilename(
            title="Import Conversation",
            filetypes=[
                ("Supported Formats (*.db, *.pb, *.json)", "*.db;*.pb;*.json"),
                ("SQLite Databases (*.db)", "*.db"),
                ("JSON Exports (*.json)", "*.json"),
                ("All Files", "*.*"),
            ],
        )
        if not file_path:
            return

        p = Path(file_path)
        ext = p.suffix.lower()
        if ext in (".db", ".pb"):
            res = import_database_file(p, self.client)
        elif ext == ".json":
            res = import_json_export(p)
        else:
            messagebox.showerror("Error", f"Unsupported file type: {ext}")
            return

        if res.get("success"):
            messagebox.showinfo("Import Success", res.get("message", "Import completed!"))
            self._refresh_all()
        else:
            messagebox.showerror("Import Error", res.get("error", "Failed importing file."))


class RecoveryDialog(ctk.CTkToplevel):
    def __init__(self, master: AntigravityGUI):
        super().__init__(master)
        self.master_app = master
        t = master.theme

        self.title("Recover Unindexed Conversations")
        self.geometry("600x460")
        self.minsize(520, 380)
        self.configure(fg_color=t["bg_window"])
        self.transient(master)
        self.grab_set()

        self._build_ui()
        self._scan()

    def _build_ui(self):
        t = self.master_app.theme
        self.grid_columnconfigure(0, weight=1)
        self.grid_rowconfigure(2, weight=1)

        header_frame = ctk.CTkFrame(self, fg_color=t["bg_sidebar"], corner_radius=0)
        header_frame.grid(row=0, column=0, sticky="ew")

        lbl = ctk.CTkLabel(
            header_frame,
            text="Crash Recovery & Session Reactivation",
            font=ctk.CTkFont(size=14, weight="bold"),
            text_color=t["text_primary"],
        )
        lbl.pack(padx=16, pady=(12, 2), anchor="w")

        sub = ctk.CTkLabel(
            header_frame,
            text="Scans disk for orphaned or unindexed sessions and reloads them into LanguageServer.",
            font=ctk.CTkFont(size=11),
            text_color=t["text_muted"],
        )
        sub.pack(padx=16, pady=(0, 12), anchor="w")

        # Metrics Box
        self.stats_frame = ctk.CTkFrame(self, fg_color=t["bg_card"], border_color=t["border_card"], border_width=1, corner_radius=6)
        self.stats_frame.grid(row=1, column=0, padx=16, pady=10, sticky="ew")
        self.stats_frame.grid_columnconfigure((0, 1, 2), weight=1)

        self.m_disk = self._create_metric(self.stats_frame, 0, "On Disk", "0")
        self.m_api = self._create_metric(self.stats_frame, 1, "Indexed in API", "0")
        self.m_lost = self._create_metric(self.stats_frame, 2, "Unindexed", "0", color=t["status_amber"])

        # Log
        self.log_box = ctk.CTkTextbox(
            self,
            fg_color=t["bg_card"],
            text_color=t["text_primary"],
            font=ctk.CTkFont(family="Consolas", size=11),
            corner_radius=6,
            border_color=t["border_card"],
            border_width=1,
        )
        self.log_box.grid(row=2, column=0, padx=16, pady=(0, 10), sticky="nsew")

        # Footer
        footer = ctk.CTkFrame(self, fg_color="transparent")
        footer.grid(row=3, column=0, padx=16, pady=(0, 16), sticky="ew")

        self.start_btn = ctk.CTkButton(
            footer,
            text="Reactivate All Sessions",
            fg_color=t["accent_blue"],
            hover_color=t["accent_blue_hover"],
            font=ctk.CTkFont(size=12, weight="bold"),
            command=self._start_recovery,
            height=32,
            corner_radius=6,
        )
        self.start_btn.pack(side="right")

        self.close_btn = ctk.CTkButton(
            footer,
            text="Close",
            fg_color=t["btn_secondary"],
            hover_color=t["btn_secondary_hover"],
            text_color=t["btn_secondary_text"],
            border_color=t["btn_secondary_border"],
            border_width=1,
            font=ctk.CTkFont(size=12),
            command=self.destroy,
            height=32,
            corner_radius=6,
        )
        self.close_btn.pack(side="left")

    def _create_metric(self, parent, col, label, val, color=None):
        t = self.master_app.theme
        color = color or t["text_primary"]
        card = ctk.CTkFrame(parent, fg_color="transparent")
        card.grid(row=0, column=col, padx=8, pady=8)
        v = ctk.CTkLabel(card, text=val, font=ctk.CTkFont(size=16, weight="bold"), text_color=color)
        v.pack()
        l = ctk.CTkLabel(card, text=label, font=ctk.CTkFont(size=11), text_color=t["text_muted"])
        l.pack()
        return v

    def _scan(self):
        engine = self.master_app.recovery_engine
        scan_res = engine.scan_unindexed()

        self.m_disk.configure(text=str(scan_res["total_disk"]))
        self.m_api.configure(text=str(scan_res["total_api"]))
        self.m_lost.configure(text=str(scan_res["unindexed_count"]))

        self.unindexed_ids = scan_res["unindexed_ids"]

        if not scan_res["connected"]:
            self.log_box.insert("end", "Notice: LanguageServer is offline.\nTo re-activate sessions into Antigravity's live memory, open the IDE.\nYou can still browse and export all sessions offline!\n\n")
        else:
            self.log_box.insert("end", f"Discovered {len(self.unindexed_ids)} sessions ready for reactivation.\nClick 'Reactivate All Sessions' to begin.\n\n")

    def _start_recovery(self):
        self.start_btn.configure(state="disabled", text="Reactivating...")
        threading.Thread(target=self._run_async_recovery, daemon=True).start()

    def _run_async_recovery(self):
        engine = self.master_app.recovery_engine

        def progress(cid, current, total):
            self.after(0, lambda: self.log_box.insert("end", f"[{current}/{total}] Reactivating {cid[:8]}...\n"))
            self.after(0, lambda: self.log_box.see("end"))

        res = engine.run_recovery(progress_callback=progress)
        self.after(0, lambda: self._on_recovery_done(res))

    def _on_recovery_done(self, res: dict[str, Any]):
        self.start_btn.configure(state="normal", text="Reactivation Finished")
        if res.get("success"):
            self.log_box.insert("end", f"\nRecovery complete: {res.get('activated_count', 0)} sessions reactivated.\n")
            self.master_app._refresh_all()
        else:
            self.log_box.insert("end", f"\nFailed: {res.get('error', 'Error')}\n")
        self.log_box.see("end")


def start_gui():
    app = AntigravityGUI()
    app.mainloop()


if __name__ == "__main__":
    start_gui()

